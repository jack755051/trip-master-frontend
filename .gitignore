# --- 依賴管理 (Dependencies) ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js 產物 (Build & Output) ---
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- 環境變數 (Environment Variables) ---
# 嚴格禁止提交真實變數，僅允許範本
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# 如果你使用 Docker 專用的環境檔也應排除
.env.docker
# 💡 註：.env.example 應保持被 git 追蹤，用來定義合約

# --- 測試與質量檢查 (Testing & Coverage) ---
coverage/
*.lcov
.vitest.result.json

# --- IDE 與編輯器 (IDE Configs) ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.swp
*.swo
.DS_Store
Thumbs.db

# --- 容器化與運維 (Docker & Infrastructure) ---
docker/data/
docker/*.log
*.pem
*.key

# --- 日誌與除錯 (Logs & Debug) ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# --- 系統與臨時文件 (Misc) ---
.vercel
.turbo
wsl/
temp/
tmp/