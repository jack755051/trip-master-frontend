# ==========================================
# 應用程式資訊
# ==========================================
# 應用程式版本號 (可用於 Footer 顯示或 API Header 追蹤)
NEXT_PUBLIC_APP_VERSION=1.0.0

# ==========================================
# API 基礎設定
# ==========================================
# 前端打 API 的基礎路徑 (給 Client 端用的，通常是相對路徑或公開網域)
NEXT_PUBLIC_API_BASE_URL=/api/v1
# API 請求超時時間 (毫秒)
NEXT_PUBLIC_API_TIMEOUT=30000

# Server 端打 API 的內部路徑 (給 SSR 用的，例如 Docker 內網位址)
INTERNAL_API_URL=http://localhost:8080/api/v1

# ==========================================
# 開發與測試開關
# ==========================================
# 是否使用前端 Mock 假資料？(true: 攔截 API 改用假資料 | false: 打真實 API)
USE_MOCK_DATA=true

# ==========================================
# 檔案上傳設定
# ==========================================
# 允許上傳的圖片格式 (用逗號分隔 MIME Type)
# 如果留空，系統將會使用預設值 (image/jpeg, image/png, image/webp)
NEXT_PUBLIC_ALLOWED_FILE_TYPES="image/jpeg, image/png, image/webp"