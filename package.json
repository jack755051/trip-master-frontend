{
  "name": "trip-master-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "// --- 開發與建置 --- //": "",
    "dev": "next dev --port=3006",
    "build": "next build",
    "start": "next start",
    "tree": "tree src/ -I 'node_modules|dist|.next|.git' -a",
    "// --- 代碼質量檢查 (Lint & Format) --- //": "",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "check": "./scripts/check-quality.sh",
    "// --- 測試環境 (Vitest) --- //": "",
    "test": "vitest",
    "test:run": "vitest run",
    "test:changed": "vitest --changed",
    "test:unit": "vitest src/services src/lib",
    "test:ui": "vitest src/components src/hooks",
    "test:coverage": "vitest run --coverage",
    "test:ui-mode": "vitest --ui",
    "// --- 工程自動化 --- //": "",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.34.1",
    "lucide-react": "^0.574.0",
    "next": "16.1.6",
    "ofetch": "^1.5.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^8.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tree-node-cli": "^3.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
